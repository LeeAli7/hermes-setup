[Unit]
Description=Hermes OpenCode Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/projects/hermes
Environment=PATH=/home/ali/projects/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ali/projects/hermes-agent/venv/bin/python3 /home/ali/projects/hermes/forwarder.py 9000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
