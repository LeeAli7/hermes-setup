# Hermes VPN-only egress configuration.
# Installed to /etc/hermes-egress/egress.env by vpn-egress/install.sh.
# No secrets belong in this file.

# Where the Python/Bun files were installed (install.sh fills this in).
HERMES_EGRESS_HOME=/home/CHANGE_ME/.hermes/ippool

# Number of independent VPNGate OpenVPN tunnels.  2 is the minimum for a
# hot standby; 3 is useful on a device with enough RAM.  Supported: 1-4.
VPNGATE_SLOTS=2

# Local Bun relay ports; slot i uses VPNGATE_RELAY_PORT_BASE + i.
VPNGATE_RELAY_PORT_BASE=9120

# CONNECT proxy ports inside each netns; slot i uses BASE + i.
VPNGATE_PROXY_PORT_BASE=8897

# Host NIC that carries the OpenVPN UDP/TCP traffic.  Leave empty to let
# install.sh detect the default-route interface.
VPNGATE_PHYS_IF=

# Egress pool HTTP API.
EGRESS_POOL_PORT=9200
EGRESS_POOL_URL=http://127.0.0.1:9200

# Absolute path to the Bun binary (install.sh fills this in).
BUN_BIN=/home/CHANGE_ME/.bun/bin/bun

# Hermes config, used only by optional diagnostics.
HERMES_CONFIG=/home/CHANGE_ME/.hermes/config.yaml

# Relay request/header dumps are OFF by default.  Set to 1 only while
# debugging; the dumps contain full prompts and should be treated as secrets.
HERMES_RELAY_DEBUG=0
